{
  "name": "robot-lab-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "predev": "node scripts/require-pnpm.mjs",
    "dev": "node scripts/dev.mjs",
    "prebuild": "node scripts/require-pnpm.mjs",
    "build": "tsc -b && vite build",
    "prepreview": "node scripts/require-pnpm.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "pretypecheck": "node scripts/require-pnpm.mjs",
    "typecheck": "tsc -b",
    "preformat": "node scripts/require-pnpm.mjs",
    "format": "prettier --write src scripts vite.config.ts tsconfig.json index.html package.json",
    "preformat:check": "node scripts/require-pnpm.mjs",
    "format:check": "prettier --check src scripts vite.config.ts tsconfig.json index.html package.json"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  },
  "packageManager": "pnpm@9.9.0"
}
